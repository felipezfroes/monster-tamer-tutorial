// ============================================================
// HP ANIMADO
// ============================================================

hp_display =
    lerp(
        hp_display,
        data.hp,
        0.15
    );


if (abs(hp_display - data.hp) < 0.05)
{
    hp_display = data.hp;
}


// ============================================================
// TIMERS
// ============================================================

if (hit_timer > 0)
{
    hit_timer--;
}


if (attack_timer > 0)
{
    attack_timer--;
}